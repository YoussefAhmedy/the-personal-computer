# Copy this file to .env and fill in your own values.
# .env is git-ignored on purpose — never commit real secrets.

# ---- server ---------------------------------------------------------------
PORT=3000
NODE_ENV=development
# Set to true only if the app is behind a reverse proxy (nginx, Caddy, a
# PaaS load balancer). Needed for secure cookies / rate limiting to see
# the real client IP and protocol.
TRUST_PROXY=false

# ---- secrets ----------------------------------------------------------
# Long random string used to sign login sessions. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If left blank, a temporary one is generated on each restart (fine for
# trying the app locally, NOT fine for a real deployment — everyone gets
# logged out every time the server restarts).
JWT_SECRET=

# How long a visitor stays logged in after entering the access code, and
# how long an admin session lasts. Uses jsonwebtoken's time span format.
JWT_VISITOR_EXPIRY=30d
JWT_ADMIN_EXPIRY=12h

# ---- cookies ------------------------------------------------------------
# Leave unset to auto-detect from NODE_ENV (secure cookies in production).
# Set explicitly to true once you're serving over HTTPS.
COOKIE_SECURE=
COOKIE_DOMAIN=

# ---- CORS ---------------------------------------------------------------
# Only needed if the frontend is hosted on a different origin than this
# API. Comma-separated list, e.g. https://mygift.example.com
CORS_ORIGINS=

# ---- first-run content (used only by `npm run seed`) ---------------------
# The shared code your recipient types to get in. Change this to
# something only the two of you would guess, then run `npm run seed:reset`
# so the change takes effect.
SITE_PASSCODE=welcome

# Your own login for the admin console at /admin.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme123

# ---- storage --------------------------------------------------------------
# Leave blank to use the defaults (backend/data/app.db, backend/uploads/).
DB_PATH=
UPLOADS_DIR=

# Upload size limits, in megabytes.
MAX_IMAGE_SIZE_MB=15
MAX_VIDEO_SIZE_MB=150
MAX_AUDIO_SIZE_MB=40
