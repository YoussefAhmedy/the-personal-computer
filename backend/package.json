{
  "name": "the-personal-computer-backend",
  "version": "1.0.0",
  "description": "Backend API for THE PERSONAL COMPUTER — a personal gift experience. Serves content, handles auth/security, and powers the admin console.",
  "private": true,
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "seed": "node src/db/seed.js",
    "seed:reset": "node src/db/seed.js --reset"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^13.0.3",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "express-validator": "^7.2.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
